# Коммерческие данные — не публикуются
*.local.md

# Окружение и секреты
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Node
node_modules/
.next/
dist/
build/

# Прочее
.scratch/
*.log
.DS_Store
# .claude/ is ignored except skills/ — those are versioned agent instructions
# (see .claude/skills/autofix/SKILL.md), not local session state. Git can't
# negate a pattern inside an already-ignored directory, hence .claude/* here
# instead of .claude/ — see https://git-scm.com/docs/gitignore#_pattern_format
.claude/*
!.claude/skills/
