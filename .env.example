# Postgres и Redis переопределяются в docker-compose.yml для контейнеров;
# эти значения нужны только при локальном запуске api/worker вне Docker.
DATABASE_URL=postgresql+psycopg://transcribator:transcribator@localhost:5432/transcribator
REDIS_URL=redis://localhost:6379

# Timeweb S3 — бакет для исходных медиафайлов. Как получить: см. README,
# раздел "Timeweb S3"
S3_ENDPOINT_URL=https://s3.timeweb.cloud
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=transcribator
S3_REGION=ru-1

# Ограничения загрузки: максимальный размер файла и размер одной части
# multipart-загрузки. Значения по умолчанию — 2 ГБ и 16 МБ
MAX_UPLOAD_SIZE_BYTES=2147483648
MULTIPART_PART_SIZE_BYTES=16777216

# Яндекс SpeechKit — распознавание речи. Как получить ключи: см. README,
# раздел "Яндекс SpeechKit"
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Timeweb AI Gateway — сводка и Диалог (OpenAI-совместимый API). Как
# получить ключ: см. README, раздел "Timeweb AI Gateway". Смена модели —
# одна строка здесь, без правки кода (см. README, "Смена модели LLM")
TIMEWEB_AI_GATEWAY_KEY=
TIMEWEB_AI_GATEWAY_URL=https://api.timeweb.ai/v1
TIMEWEB_AI_GATEWAY_MODEL=gpt-4o-mini
# Сколько токенов транскрипта помещается в один запрос к модели Диалога
MAX_DIALOG_CONTEXT_TOKENS=100000

# Авторизация — сгенерируйте случайную строку для JWT_SECRET_KEY
# (например: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=
# Срок действия токена входа, в минутах. По умолчанию — 7 дней
JWT_EXPIRES_MINUTES=10080
# Первый Администратор создаётся при старте API, если не существует
ADMIN_EMAIL=
ADMIN_PASSWORD=

# "fast" (~30 мин, полная цена) или "deferred" (до 24ч, ~в 4 раза дешевле).
# Как переключить режим распознавания по умолчанию: см. README,
# "Переключение режима распознавания"
DEFAULT_PROCESSING_MODE=deferred
# Лимит загрузок на Пользователя в календарные сутки МСК
DAILY_UPLOAD_QUOTA=3

# Адрес фронтенда — используется в письмах и Telegram-уведомлениях
# для прямой ссылки на страницу результата. В проде — публичный домен
# с https://, например https://transcribator.example.com
FRONTEND_BASE_URL=http://localhost:3000

# SMTP — письма о готовности Записи. Пусто = уведомления не отправляются,
# ошибка пишется в логи, обработка Записи не прерывается. Как получить:
# см. README, раздел "SMTP"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# Telegram-бот — опциональное дублирование уведомлений (после привязки
# пользователем в личном кабинете). Пусто = работает как обычно, без
# Telegram. Как получить: см. README, раздел "Telegram-бот"
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Передаётся в Telegram при регистрации вебхука (setWebhook secret_token) —
# без него любой, кто узнает код привязки, может опередить владельца
TELEGRAM_WEBHOOK_SECRET=

# Ретеншн (D6): медиа удаляется из S3 через MEDIA_RETENTION_DAYS дней,
# Транскрипт/Сводка/Диалог живут дольше и удаляются вместе с Записью
# целиком через DATA_RETENTION_DAYS дней. Ночная джоба в воркере (03:00 UTC)
MEDIA_RETENTION_DAYS=30
DATA_RETENTION_DAYS=180

# --- Только для продового docker-compose.prod.yml (Caddy, TLS) ---
# Учётные данные Postgres — задайте свой пароль, используется и контейнером
# postgres, и DATABASE_URL для api/worker внутри docker-compose.prod.yml
POSTGRES_USER=transcribator
POSTGRES_PASSWORD=change-me-to-a-random-password
POSTGRES_DB=transcribator

# Домены должны указывать A-записью на IP сервера до запуска — Caddy сам
# получает сертификаты Let's Encrypt при первом обращении. См. README,
# раздел "Развёртывание в проде"
DOMAIN=transcribator.example.com
API_DOMAIN=api.transcribator.example.com
# Email для уведомлений Let's Encrypt об истечении сертификата
CADDY_ACME_EMAIL=admin@example.com
