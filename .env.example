# Postgres и Redis переопределяются в docker-compose.yml для контейнеров;
# эти значения нужны только при локальном запуске api/worker вне Docker.
DATABASE_URL=postgresql+psycopg://transcribator:transcribator@localhost:5432/transcribator
REDIS_URL=redis://localhost:6379

# Timeweb S3 — бакет для исходных медиафайлов
S3_ENDPOINT_URL=https://s3.timeweb.cloud
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=transcribator
S3_REGION=ru-1

# Яндекс SpeechKit — распознавание речи
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Timeweb AI Gateway — сводка (OpenAI-совместимый API)
TIMEWEB_AI_GATEWAY_KEY=
TIMEWEB_AI_GATEWAY_URL=https://api.timeweb.ai/v1
TIMEWEB_AI_GATEWAY_MODEL=gpt-4o-mini

# Авторизация — сгенерируйте случайную строку для JWT_SECRET_KEY
# (например: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=
# Первый Администратор создаётся при старте API, если не существует
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Адрес фронтенда — используется в письмах и Telegram-уведомлениях
# для прямой ссылки на страницу результата
FRONTEND_BASE_URL=http://localhost:3000

# SMTP — письма о готовности Записи. Пусто = уведомления не отправляются,
# ошибка пишется в логи, обработка Записи не прерывается
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# Telegram-бот — опциональное дублирование уведомлений (после привязки
# пользователем в личном кабинете). Пусто = работает как обычно, без Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Передаётся в Telegram при регистрации вебхука (setWebhook secret_token) —
# без него любой, кто узнает код привязки, может опередить владельца
TELEGRAM_WEBHOOK_SECRET=
